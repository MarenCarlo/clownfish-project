# ==========================================
# APLICACION Y ENTORNO
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# ==========================================
# MINIO - SERVICIO DE ARCHIVOS E IMAGENES
# ==========================================
MINIO_STORAGE_ENDPOINT=oasiscloud.tdoriente.com:9600
MINIO_STORAGE_ACCESS_KEY=your_minio_access_key
MINIO_STORAGE_SECRET_KEY=your_minio_secret_key
MINIO_STORAGE_MEDIA_BUCKET_NAME=tdoriente
MINIO_STORAGE_USE_HTTPS=false

# ==========================================
# BD 1: USUARIOS Y AUTENTICACION (oasis_one)
# ==========================================
DB_AUTH_HOST=192.168.250.99
DB_AUTH_PORT=3306
DB_AUTH_USER=your_db_auth_user
DB_AUTH_PASSWORD=your_db_auth_password
DB_AUTH_NAME=oasis_one

# ==========================================
# BD 2: CLOWNFISH DATA (ClownfishDB)
# ==========================================
DB_HOST=192.168.250.99
DB_PORT=3306
DB_USER=your_db_clownfish_user
DB_PASSWORD=your_db_clownfish_password
DB_NAME=ClownfishDB

# ==========================================
# SEGURIDAD Y SESIONES (JWT)
# ==========================================
JWT_TOKEN_SECRET=your_super_secret_jwt_token_here

# ==========================================
# TELEGRAM BOT (OPCIONAL)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEXT_PUBLIC_TELEGRAM_BOT_NAME=
MAX_WS_CONNECTIONS=100
